{
  "manifest_version": 3,
  "name": "InstantAction",
  "version": "1.0.0",
  "description": "Actions rapides contextuelles sur n'importe quelle page : palette de commandes, barre de sélection, notes, workflows.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "contextMenus", "clipboardWrite", "downloads"],
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "action": {
    "default_title": "InstantAction",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*.js", "content/styles.css", "shared/*.js", "actions/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "ouvrir-palette": {
      "suggested_key": { "default": "Alt+Space", "mac": "Alt+Space" },
      "description": "Ouvrir la palette de commandes"
    },
    "copier-propre": {
      "suggested_key": { "default": "Alt+C", "mac": "Alt+C" },
      "description": "Copier proprement la sélection"
    },
    "note-rapide": {
      "suggested_key": { "default": "Alt+N", "mac": "Alt+N" },
      "description": "Ajouter une note"
    },
    "ouvrir-actions": {
      "suggested_key": { "default": "Alt+Shift+O", "mac": "Alt+Shift+O" },
      "description": "Ouvrir les actions disponibles"
    }
  }
}
